#!/bin/bash
# Shred stale secrets left behind in /tmp/secure-entry.
#
# secure-entry writes dropped secrets to /tmp/secure-entry/<label>. Nothing
# removed them, so live API keys accumulated there until reboot -- a Stripe
# sk_live, a Cloudflare token and a Tailscale key were found sitting there
# weeks later. --shred-after handles secrets you remember to flag; this sweeps
# the rest.
#
#   bin/cush-secrets-reap              # list what is stale (default: 24h)
#   bin/cush-secrets-reap --age 2h     # different threshold
#   bin/cush-secrets-reap --force      # actually shred
#   bin/cush-secrets-reap --all --force  # shred everything, any age
set -euo pipefail

DIR="/tmp/secure-entry"
AGE="24h"; FORCE=""; ALL=""

while [ $# -gt 0 ]; do
    case "$1" in
        --age)   AGE="$2"; shift 2 ;;
        --age=*) AGE="${1#--age=}"; shift ;;
        --force) FORCE=1; shift ;;
        --all)   ALL=1; shift ;;
        -h|--help) sed -n '2,14p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 1 ;;
    esac
done

[ -d "$DIR" ] || { echo "nothing at $DIR"; exit 0; }

MINS=$(python3 - "$AGE" <<'EOF'
import re, sys
m = re.fullmatch(r'(\d+)\s*([smhd]?)', sys.argv[1].strip().lower())
if not m: sys.exit(1)
print(max(0, int(m.group(1)) * {'':60,'s':1,'m':60,'h':3600,'d':86400}[m.group(2)] // 60))
EOF
) || { echo "invalid --age: $AGE" >&2; exit 1; }

if [ -n "$ALL" ]; then
    mapfile -t HITS < <(find "$DIR" -mindepth 1 -maxdepth 1 2>/dev/null | sort)
else
    mapfile -t HITS < <(find "$DIR" -mindepth 1 -maxdepth 1 -mmin "+$MINS" 2>/dev/null | sort)
fi

if [ ${#HITS[@]} -eq 0 ]; then
    echo "clean -- nothing older than $AGE in $DIR"
    exit 0
fi

echo "${#HITS[@]} stale secret(s) in $DIR${ALL:+ (--all)}:"
for h in "${HITS[@]}"; do
    printf "  %-44s %s  %s\n" "$h" \
        "$(date -r "$h" '+%Y-%m-%d %H:%M' 2>/dev/null)" \
        "$( [ -d "$h" ] && echo '(dir)' || echo "$(head -c 8 "$h" 2>/dev/null | tr -dc '[:print:]')…" )"
done

if [ -z "$FORCE" ]; then
    echo
    echo "dry run -- re-run with --force to shred"
    exit 0
fi

for h in "${HITS[@]}"; do
    if [ -d "$h" ]; then
        find "$h" -type f -exec shred -u {} \; 2>/dev/null
        rmdir "$h" 2>/dev/null || true
    else
        shred -u "$h" 2>/dev/null || rm -f "$h"
    fi
done
echo "shredded ${#HITS[@]} item(s)"
