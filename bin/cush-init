#!/bin/bash
# cush-tools: scaffold a new project for 1Password-backed secrets.
#
# Drops a minimal `.cush-secrets` manifest, an optional `.envrc` for direnv
# auto-loading, and gitignore entries that keep `.env` files off disk in
# version control. Idempotent: re-running on an already-init'd project is a
# no-op (only fills in missing pieces).
#
# After init: edit `.cush-secrets`, then run `bin/inject` to materialize a
# `.env` from 1Password, or `bin/stash` to migrate an existing `.env` into
# 1Password.

set -euo pipefail

TUNNEL_DIR="$(cd "$(dirname "$0")/.." && pwd)"

show_help() {
    cat <<'EOF'
Usage: bin/cush-init [project-dir] [options]

Scaffold a new project to use cush-tools' 1Password-backed secrets workflow.
Writes `.cush-secrets` (empty manifest), `.envrc` (if direnv installed), and
appends the cush-tools block to `.gitignore`. Re-running is idempotent.

  bin/cush-init                          # init in $PWD (default: both mode)
  bin/cush-init ./newproj                # mkdir + init in ./newproj
  bin/cush-init --vault Work             # use Work vault as default
  bin/cush-init --project-name myapp     # override basename-of-dir
  bin/cush-init --no-direnv              # skip writing .envrc
  bin/cush-init --shell-only             # .envrc exports to shell, no .env on disk
  bin/cush-init --git-init               # also run `git init` if not a repo

Options:
  --vault <name>            Default vault for the manifest (default: cush)
  --project-name <name>     Override `{project}` substitution (default: dir basename)
  --no-direnv               Don't write .envrc even if direnv is installed
  --shell-only              Write a shell-only .envrc that exports values into
                            the shell via `eval` and never writes .env to disk.
                            Use for projects without docker-compose or other
                            tools that need a literal .env file (Next.js, Vite,
                            most Node/Python apps that read from process.env).
  --git-init                Run `git init` if the dir isn't already a git repo
  -h, --help                Show this help

.envrc modes:
  default ("both")          .envrc refreshes .env from 1Password on every cd,
                            then `dotenv` exports the .env values into shell.
                            Best for projects that need a .env on disk
                            (docker-compose, Prisma, etc.).
  --shell-only              .envrc evals `bin/inject --env` directly. No .env
                            written. Best for shell/CLI projects and apps that
                            read process.env at runtime only.

What gets written:
  .cush-secrets             Minimal manifest with empty [secrets] section.
                            Edit it to add `KEY = "op://vault/item/field"` entries.
  .envrc                    direnv hook that auto-loads secrets via bin/inject
                            on `cd` (requires `direnv allow` once).
  .gitignore                Appends `.env`, `.env.*`, `!.env.example`, and
                            `.cush-secrets.materialized/`.

Next steps after init:
  1. Edit .cush-secrets and add the env vars this project needs.
  2. Run `bin/inject` to populate values from 1Password (it will spawn forms
     for any missing values), or `bin/stash` to migrate an existing .env.
  3. (If direnv is installed) run `direnv allow` to enable auto-loading.

The manifest is safe to commit — it stores op:// pointers, not secrets.
EOF
}

# Parse flags.
PROJECT_DIR=""
VAULT="cush"
PROJECT_NAME=""
NO_DIRENV=0
SHELL_ONLY=0
DO_GIT_INIT=0

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        --vault)
            [ $# -ge 2 ] || { echo "cush-init: --vault requires a value" >&2; exit 2; }
            VAULT="$2"
            shift 2
            ;;
        --project-name)
            [ $# -ge 2 ] || { echo "cush-init: --project-name requires a value" >&2; exit 2; }
            PROJECT_NAME="$2"
            shift 2
            ;;
        --no-direnv)
            NO_DIRENV=1
            shift
            ;;
        --shell-only)
            SHELL_ONLY=1
            shift
            ;;
        --git-init)
            DO_GIT_INIT=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "cush-init: unknown option: $1" >&2
            echo "Try 'bin/cush-init --help' for usage." >&2
            exit 2
            ;;
        *)
            if [ -z "$PROJECT_DIR" ]; then
                PROJECT_DIR="$1"
                shift
            else
                echo "cush-init: unexpected positional arg: $1" >&2
                exit 2
            fi
            ;;
    esac
done

# Default project dir to $PWD.
if [ -z "$PROJECT_DIR" ]; then
    PROJECT_DIR="$PWD"
fi

# mkdir -p the dir if missing.
if [ ! -d "$PROJECT_DIR" ]; then
    mkdir -p "$PROJECT_DIR"
fi

PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"

# Resolve project name from dir basename if not overridden.
if [ -z "$PROJECT_NAME" ]; then
    PROJECT_NAME="$(basename "$PROJECT_DIR")"
fi

MANIFEST="$PROJECT_DIR/.cush-secrets"
ENVRC="$PROJECT_DIR/.envrc"
GITIGNORE="$PROJECT_DIR/.gitignore"

# Track what we did so we can decide between "already initialized" and
# "wrote N pieces".
WROTE_MANIFEST=0
WROTE_ENVRC=0
WROTE_GITIGNORE=0
DID_GIT_INIT=0

# 1. Manifest. Don't overwrite an existing one.
if [ ! -f "$MANIFEST" ]; then
    cat > "$MANIFEST" <<EOF
schema = 1

[defaults]
target_vault   = "$VAULT"
target_item    = "$PROJECT_NAME"
field_template = "{key}"

[secrets]
# add KEY = "op://$VAULT/$PROJECT_NAME/<key>" entries here, then run \`bin/inject\` to materialize
EOF
    WROTE_MANIFEST=1
fi

# 2. .envrc — write only if direnv is installed and --no-direnv wasn't passed.
DIRENV_PRESENT=0
if command -v direnv >/dev/null 2>&1; then
    DIRENV_PRESENT=1
fi

if [ "$NO_DIRENV" -eq 0 ] && [ "$DIRENV_PRESENT" -eq 1 ] && [ ! -f "$ENVRC" ]; then
    if [ "$SHELL_ONLY" -eq 1 ]; then
        cat > "$ENVRC" <<EOF
# cush-tools — shell-only mode (no .env file written)
# Exports secrets directly into shell via direnv. Use this for projects that
# don't need a .env file on disk (no docker-compose, Next.js, Vite, etc.).
# Requires direnv — \`direnv allow\` in this dir to enable.
if command -v $TUNNEL_DIR/bin/inject >/dev/null; then
  eval "\$($TUNNEL_DIR/bin/inject --env --no-prompt 2>/dev/null || true)"
fi
EOF
    else
        cat > "$ENVRC" <<EOF
# cush-tools — auto-loads secrets from 1Password via bin/inject
# Refreshes .env from 1Password on cd, then exports values into shell.
# Requires direnv (https://direnv.net) — \`direnv allow\` in this dir to enable.
if command -v $TUNNEL_DIR/bin/inject >/dev/null; then
  $TUNNEL_DIR/bin/inject --no-prompt 2>/dev/null || true
fi
[ -f .env ] && dotenv
EOF
    fi
    WROTE_ENVRC=1
fi

# 3. .gitignore — append our block if it isn't already there. We check for
# the marker comment as the idempotency token; the rest of the block goes in
# only if the marker is missing.
GITIGNORE_MARKER="# cush-tools"
GITIGNORE_BLOCK="# cush-tools
.env
.env.*
!.env.example
.cush-secrets.materialized/"

needs_gitignore_block=1
if [ -f "$GITIGNORE" ]; then
    if grep -Fxq "$GITIGNORE_MARKER" "$GITIGNORE"; then
        needs_gitignore_block=0
    fi
fi

if [ "$needs_gitignore_block" -eq 1 ]; then
    # If the file exists and doesn't end with a newline, add one before
    # appending so the block lands on its own line.
    if [ -f "$GITIGNORE" ] && [ -s "$GITIGNORE" ]; then
        if [ "$(tail -c1 "$GITIGNORE" | wc -l)" -eq 0 ]; then
            printf '\n' >> "$GITIGNORE"
        fi
        printf '\n%s\n' "$GITIGNORE_BLOCK" >> "$GITIGNORE"
    else
        # Fresh file (or empty existing file) — write block as-is with trailing newline.
        printf '%s\n' "$GITIGNORE_BLOCK" > "$GITIGNORE"
    fi
    WROTE_GITIGNORE=1
fi

# 4. Optional git init.
if [ "$DO_GIT_INIT" -eq 1 ]; then
    if ! ( cd "$PROJECT_DIR" && git rev-parse --git-dir >/dev/null 2>&1 ); then
        ( cd "$PROJECT_DIR" && git init >/dev/null )
        DID_GIT_INIT=1
    fi
fi

# 5. Stderr summary.
total_changes=$((WROTE_MANIFEST + WROTE_ENVRC + WROTE_GITIGNORE + DID_GIT_INIT))

if [ "$total_changes" -eq 0 ]; then
    echo "cush-init: already initialized in $PROJECT_DIR — no changes." >&2
    exit 0
fi

{
    echo ""
    echo "cush-tools initialized in $PROJECT_DIR"
    echo ""
    echo "  manifest:   .cush-secrets$([ "$WROTE_MANIFEST" -eq 1 ] || echo " (already present)")"
    if [ "$WROTE_ENVRC" -eq 1 ]; then
        echo "  direnv:     .envrc written — run \`direnv allow\` to enable auto-loading"
    elif [ "$NO_DIRENV" -eq 1 ]; then
        echo "  direnv:     skipped (--no-direnv)"
    elif [ "$DIRENV_PRESENT" -eq 0 ]; then
        echo "  direnv:     not installed — tip: install direnv for auto-loading on cd"
    elif [ -f "$ENVRC" ]; then
        echo "  direnv:     .envrc already present"
    fi
    echo "  gitignore:  .gitignore$([ "$WROTE_GITIGNORE" -eq 1 ] && echo " updated" || echo " already has cush-tools block")"
    if [ "$DID_GIT_INIT" -eq 1 ]; then
        echo "  git:        initialized new repo"
    fi
    echo ""
    echo "Next steps:"
    echo "  1. Edit .cush-secrets to add the env vars this project needs:"
    echo "       DATABASE_URL = \"op://$VAULT/$PROJECT_NAME/database_url\""
    echo ""
    echo "  2. (First time) Run \`bin/stash\` if you have an existing .env to migrate,"
    echo "     or \`bin/inject\` to populate values from 1Password (will prompt for any missing)."
    echo ""
    if [ "$WROTE_ENVRC" -eq 1 ]; then
        echo "  3. (direnv) \`direnv allow\` to enable auto-loading on cd."
    fi
} >&2
