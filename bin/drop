#!/bin/bash
# Start a file drop server and expose it via tunnel
# Usage: bin/drop [name]
# Example: bin/drop           -> random subdomain like drop-a1b2c3.tunnel.cush.rocks
#          bin/drop myfiles   -> myfiles.tunnel.cush.rocks

TUNNEL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$TUNNEL_DIR/lib/tunnel-state.sh"

# --expires/--password/--guest-link/--max-opens/--burn (lib/door-flags.sh)
door_flags_parse "$@" || exit 2
set -- "${DOOR_REST[@]}"

# Strip --bg from args early
BG_MODE=""
ORIG_ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--bg" ]; then BG_MODE=1
    else ORIG_ARGS+=("$arg"); fi
done
set -- "${ORIG_ARGS[@]}"

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Usage: drop [name]"
  echo "Door flags: --expires 30m|2h|1d|<ISO time>|never  --password  --guest-link  --max-opens N  --burn"
  echo ""
  echo "Start a file drop server and expose it via tunnel."
  echo "Anyone with the link can upload files to your machine. Only the owner"
  echo "(a browser enrolled with porch-auth) can list or download them; a guest only"
  echo "sees what they just sent. Each drop holds at most 20GB / 5000 files and"
  echo "stops accepting uploads when the disk has under 1GB free."
  echo ""
  echo "Examples:"
  echo "  drop              -> random subdomain (e.g. drop-a1b2c3.${PORCH_TUNNEL_BASE})"
  echo "  drop myfiles      -> myfiles.${PORCH_TUNNEL_BASE}"
  echo ""
  echo "Files are saved to ~/drops/<name>/"
  exit 0
fi

NAME="$1"
if [ -z "$NAME" ]; then
  NAME="drop-$(head -c3 /dev/urandom | xxd -p)"
fi
# $NAME also names the directory under ~/drops — validate before mkdir.
tunnel_require_valid_name "$NAME"

# Before the --bg re-exec: the password prompt needs our terminal, and the
# spec (hash only) crosses the re-exec in env, never argv.
door_spec_build "$BG_MODE" "$NAME" || exit 2

# Handle --bg mode (after name resolution)
if [ -n "$BG_MODE" ] && [ "${_CUSH_DAEMONIZED:-}" != "1" ]; then
    LOG_FILE="$TUNNEL_DIR/logs/${NAME}.log"
    cush_daemonize "$NAME" "$LOG_FILE" "$0" "$NAME" && {
        echo "Drop: https://${NAME}.${PORCH_TUNNEL_BASE}"
        echo "Files will be saved to: $HOME/drops/$NAME/"
        door_print_summary "$NAME"
        echo "Log: $LOG_FILE"
        exit 0
    }
    exit 1
fi

DROP_DIR="$HOME/drops/$NAME"
mkdir -p "$DROP_DIR"

# Auto-pick a free port
PORT=$(python3 -c "import socket; s=socket.socket(); s.bind(('',0)); print(s.getsockname()[1]); s.close()")

HTTP_PID=""

cleanup() {
  door_owned_release "$NAME" >/dev/null     # records "closed" if nobody said why
  tunnel_state_cleanup "$NAME"
  if [ -n "$HTTP_PID" ]; then
    kill "$HTTP_PID" 2>/dev/null
    wait "$HTTP_PID" 2>/dev/null
  fi
}

trap cleanup EXIT INT TERM

# Start drop server in the background. Loopback only: frpc is its one client.
# --devices points at the porch-auth registry so the owner's enrolled browser
# can list + download; without a match nobody can (fail closed), and guests
# can only add files.
python3 "$TUNNEL_DIR/lib/dropserver.py" \
    --port "$PORT" \
    --bind 127.0.0.1 \
    --dir "$DROP_DIR" \
    --devices "$TUNNEL_DIR/data/devices.json" &
HTTP_PID=$!
wait_for_port "$PORT" || exit 1

door_recipe_write "$NAME" drop
tunnel_state_register "$NAME" "drop" $$ "$PORT"
tunnel_state_watchdog "$NAME" &

echo "Drop: https://${NAME}.${PORCH_TUNNEL_BASE}"
echo "Files will be saved to: $DROP_DIR"
echo ""

door_print_summary "$NAME"

# Run tunnel in the foreground
export TUNNEL_NO_STATE=1
"$TUNNEL_DIR/bin/tunnel" "$PORT" "$NAME"
