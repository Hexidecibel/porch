#!/usr/bin/env python3
"""porch-acme-http-hook auth|cleanup: certbot --manual http-01 hook for the
web wizard's IP-address bootstrap certificate.

certbot runs it with CERTBOT_TOKEN / CERTBOT_VALIDATION set; the wizard sets
PORCH_ACME_WEBROOT to the directory it serves at /.well-known/acme-challenge/.
Implementation: lib/porch_setup/acme.py http_hook_main().
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from porch_setup.acme import http_hook_main  # noqa: E402

if __name__ == "__main__":
    sys.exit(http_hook_main(sys.argv[1] if len(sys.argv) > 1 else ""))
