#!/usr/bin/env bash
#
# publish-tarball — rebuild and republish the cush-tools repo tarball that
# site/install.sh fetches from https://tunnel.cush.rocks/cush-tools.tar.gz.
#
# Called automatically by bin/deploy. Can also be invoked directly.
#
# Usage: bin/publish-tarball              build + publish to /var/www/tunnel/
#        bin/publish-tarball --out FILE   build into FILE only (no sudo, no publish)
#        bin/publish-tarball --out FILE --prefix porch   top-level dir (default cush-tools;
#                                         bin/release builds porch.tar.gz with porch/)
#
# Next to the tarball (or FILE) it writes cush-tools.tar.gz.sha256 (FILE.sha256),
# "<hex>  <file name>", which site/porch.sh checks before unpacking.
#
# Paths in share/public-exclude.txt (CLAUDE.md, todo.md, .claude/, the private
# marker list, ...) never ship: the tarball has at most what the public repo has.
#
# The file list is an allowlist: only paths git knows about (tracked, or
# untracked-but-not-ignored) are packed, so anything gitignored (devices.json
# and its backups, history.jsonl, admin tokens, locks, logs, real *.toml
# configs) can never ship. Without git (a fresh install from a tarball) the
# list is share/porch-files.txt, the manifest shipped inside that tarball. A
# second, explicit check then aborts if any path under data/ other than
# data/links.json, or any secret-looking name, made it in.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DEST="${PORCH_WEB_ROOT:-/var/www/tunnel}/cush-tools.tar.gz"
SUDO=sudo
[[ -w "$(dirname "$DEST")" ]] && SUDO=""
OUT=""
PREFIX="cush-tools"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --out) OUT="${2:?--out needs a path}"; shift 2 ;;
        --prefix) PREFIX="${2:?--prefix needs a name}"; shift 2 ;;
        -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done
[[ "$PREFIX" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "bad --prefix: $PREFIX" >&2; exit 2; }
SUMNAME="cush-tools.tar.gz"
[[ -n "$OUT" ]] && SUMNAME="$(basename "$OUT")"

TMPDIR_PT="$(mktemp -d)"
cleanup() { rm -rf "$TMPDIR_PT"; }
trap cleanup EXIT
TARBALL="$TMPDIR_PT/cush-tools.tar.gz"
LIST="$TMPDIR_PT/files"

# The allowlist (lib/porch_files.py): in a git checkout, what git knows
# (tracked + untracked-not-ignored); in an install unpacked from a tarball or
# a `git archive` upload (no .git), the share/porch-files.txt manifest that
# was written from git when that tarball/upload was made. The same denylist
# and the same hard stop (nothing from data/ but links.json and the porch
# router tables, no secret-shaped names) apply to both.
if ! python3 -I "$REPO_ROOT/lib/porch_files.py" list "$REPO_ROOT" > "$LIST" 2> "$TMPDIR_PT/src"; then
    cat "$TMPDIR_PT/src" >&2
    exit 1
fi
SOURCE="$(sed -n 's/^(file list from \(.*\))$/\1/p' "$TMPDIR_PT/src")"

echo "→ packaging $(wc -l < "$LIST") files from $REPO_ROOT ($SOURCE)"
# The list is relative to the checkout; the $PREFIX/ dir is added by tar,
# so this works whatever the checkout directory is called (a worktree, a clone).
tar -C "$REPO_ROOT" --no-recursion --transform "s,^,$PREFIX/," -cf "$TMPDIR_PT/t.tar" -T "$LIST"
if [[ "$SOURCE" == git ]]; then
    # Ship the manifest so an install made from this tarball can repack it.
    mkdir -p "$TMPDIR_PT/m/share"
    python3 -I "$REPO_ROOT/lib/porch_files.py" manifest "$REPO_ROOT" > "$TMPDIR_PT/m/share/porch-files.txt"
    tar -C "$TMPDIR_PT/m" --transform "s,^,$PREFIX/," -rf "$TMPDIR_PT/t.tar" share/porch-files.txt
fi
gzip -n -c "$TMPDIR_PT/t.tar" > "$TARBALL"

# Sanity-check: tarball must be non-empty and contain expected files.
if [[ ! -s "$TARBALL" ]]; then
    echo "✗ tarball is empty: $TARBALL" >&2
    exit 1
fi

EXPECTED=(
    "$PREFIX/bin/tunnel"
    "$PREFIX/lib/authserver.py"
    "$PREFIX/config/frpc.toml.example"
)

LISTING="$(tar -tzf "$TARBALL")"
for entry in "${EXPECTED[@]}"; do
    if ! grep -qxF "$entry" <<<"$LISTING"; then
        echo "✗ tarball missing expected entry: $entry" >&2
        exit 1
    fi
done
if grep -E "^$PREFIX/data/" <<<"$LISTING" | grep -vxqF -e "$PREFIX/data/links.json" -e "$PREFIX/data/porch/router-guides.json" -e "$PREFIX/data/porch/oui.json" -e "$PREFIX/data/porch/"; then
    echo "✗ tarball contains data/ files other than links.json and the porch router tables" >&2
    exit 1
fi

# The checksum site/porch.sh (and site/install.sh) verify: "<hex>  <file name>".
HEX="$(sha256sum "$TARBALL" | cut -d' ' -f1)"
printf '%s  %s\n' "$HEX" "$SUMNAME" > "$TMPDIR_PT/cush-tools.tar.gz.sha256"

# Installs are atomic: copy next to the target, then rename over it, the
# tarball first and its .sha256 right after.
if [[ -n "$OUT" ]]; then
    cp "$TARBALL" "$OUT.tmp.$$"
    mv -f "$OUT.tmp.$$" "$OUT"
    cp "$TMPDIR_PT/cush-tools.tar.gz.sha256" "$OUT.sha256.tmp.$$"
    mv -f "$OUT.sha256.tmp.$$" "$OUT.sha256"
    echo "✓ built $OUT ($(stat -c '%s' "$OUT") bytes, sha256 $HEX) + $OUT.sha256"
    exit 0
fi

echo "→ publishing → $DEST"
$SUDO install -m 644 "$TARBALL" "$DEST.tmp.$$"
$SUDO mv -f "$DEST.tmp.$$" "$DEST"
$SUDO install -m 644 "$TMPDIR_PT/cush-tools.tar.gz.sha256" "$DEST.sha256.tmp.$$"
$SUDO mv -f "$DEST.sha256.tmp.$$" "$DEST.sha256"
echo "✓ published $DEST.sha256 ($HEX)"

SIZE="$(stat -c '%s' "$DEST")"
MTIME="$(date -u -r "$DEST" +'%Y-%m-%dT%H:%M:%SZ')"
echo "✓ published $DEST (${SIZE} bytes, mtime ${MTIME})"
